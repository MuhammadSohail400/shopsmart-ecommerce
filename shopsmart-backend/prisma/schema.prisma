// ShopSmart AI - Prisma Schema
// Phase 1-3 scope only: Identity & Access, User Management, Product Catalog,
// Categories, Brands, Inventory (per DDD v1.0, Sections 2-5)
// Remaining domains (Cart, Orders, Payments, etc.) are added in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums (DDD Section 11 naming convention) ----------

enum Role {
  customer
  admin
  inventory_manager
  support_agent
}

enum ProductStatus {
  draft
  pending_review
  approved
  rejected
}

enum DiscountType {
  percentage
  flat
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  disputed
  refunded
}

enum PaymentMethod {
  card
  cod
  bank_transfer
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  partially_refunded
}

enum RefundStatus {
  pending
  succeeded
  failed
}

enum ShipmentStatus {
  pending
  shipped
  in_transit
  delivered
  failed
}

// ---------- Identity & Access (DDD Section 2.1) ----------

model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  phone         String?  @unique
  passwordHash  String   @map("password_hash")
  role          Role     @default(customer)
  emailVerified Boolean  @default(false) @map("email_verified")
  phoneVerified Boolean  @default(false) @map("phone_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  refreshTokens RefreshToken[]
  addresses     Address[]
  cart          Cart?
  wishlist      Wishlist?
  orders        Order[]
  reviews       Review[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------- User Management (DDD Section 2.2) ----------

model Address {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  fullName   String   @map("full_name")
  phone      String
  line1      String
  city       String
  region     String
  postalCode String?  @map("postal_code")
  country    String
  isDefault  Boolean  @default(false) @map("is_default")
  deletedAt  DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ---------- Categories (DDD Section 2.4) ----------

model Category {
  id       String    @id @default(uuid())
  parentId String?   @map("parent_id")
  name     String
  slug     String    @unique
  depth    Int       @default(0)
  deletedAt DateTime? @map("deleted_at")

  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToParent")
  products Product[]

  @@map("categories")
}

// ---------- Brands (DDD Section 2.5) ----------

model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  deletedAt DateTime? @map("deleted_at")

  products Product[]

  @@map("brands")
}

// ---------- Product Catalog (DDD Section 2.3) ----------

model Product {
  id          String        @id @default(uuid())
  categoryId  String        @map("category_id")
  brandId     String?       @map("brand_id")
  title       String
  slug        String        @unique
  description String
  basePrice   Decimal       @map("base_price") @db.Decimal(12, 2)
  status      ProductStatus @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  category Category         @relation(fields: [categoryId], references: [id])
  brand    Brand?           @relation(fields: [brandId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  wishlistItems WishlistItem[]
  reviews Review[]

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductVariant {
  id             String    @id @default(uuid())
  productId      String    @map("product_id")
  sku            String    @unique
  attributes     Json      @default("{}")
  priceModifier  Decimal   @default(0) @map("price_modifier") @db.Decimal(12, 2)
  deletedAt      DateTime? @map("deleted_at")

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([productId, attributes])
  @@map("product_variants")
}

model ProductImage {
  id        String @id @default(uuid())
  productId String @map("product_id")
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ---------- Inventory (DDD Section 2.6, DDR-006: separate table) ----------

model Inventory {
  id                String @id @default(uuid())
  productVariantId  String @unique @map("product_variant_id")
  quantity          Int    @default(0)
  reservedQuantity  Int    @default(0) @map("reserved_quantity")
  lowStockThreshold Int    @default(5) @map("low_stock_threshold")
  version           Int    @default(0) // optimistic locking counter (DDD Section 14.1)

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

// ---------- Shopping Cart (DDD Section 2.7) — registered users only; ----------
// ---------- guest carts live in Redis per SDD Section 6, not here.    ----------

model Cart {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id               String @id @default(uuid())
  cartId           String @map("cart_id")
  productVariantId String @map("product_variant_id")
  quantity         Int

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([cartId, productVariantId])
  @@map("cart_items")
}

// ---------- Wishlist (DDD Section 2.8) ----------

model Wishlist {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String @id @default(uuid())
  wishlistId String @map("wishlist_id")
  productId  String @map("product_id")

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ---------- Coupons (DDD Section 2.9) ----------

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  discountType      DiscountType @map("discount_type")
  discountValue     Decimal      @map("discount_value") @db.Decimal(12, 2)
  minOrderValue     Decimal      @default(0) @map("min_order_value") @db.Decimal(12, 2)
  usageLimitPerUser Int?         @map("usage_limit_per_user")
  startDate         DateTime     @map("start_date")
  endDate           DateTime     @map("end_date")
  deletedAt         DateTime?    @map("deleted_at")

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id              String   @id @default(uuid())
  couponId        String   @map("coupon_id")
  userId          String?  @map("user_id") // nullable: guest checkout (BR-002)
  orderId         String   @unique @map("order_id")
  discountApplied Decimal  @map("discount_applied") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // F-2 fix: unique constraint closes the concurrent-redemption race condition for
  // authenticated users (NULL != NULL in Postgres, so guest rows are still allowed).
  // Requires: npx prisma migrate dev
  @@unique([couponId, userId])
  // F-4: retained as a forward-looking index for "my redemption history" queries;
  // no current code path uses it but it is the correct index for that feature.
  @@index([userId])
  @@map("coupon_redemptions")
}

// ---------- Checkout (DDD Section 2.10) — ephemeral orchestration state ----------

model CheckoutSession {
  id              String    @id @default(uuid())
  userId          String?   @map("user_id") // nullable: guest checkout
  guestCartId     String?   @map("guest_cart_id")
  addressId       String?   @map("address_id")
  guestAddress    Json?     @map("guest_address") // inline address for guest checkout
  shippingMethod  String?   @map("shipping_method")
  idempotencyKey  String    @unique @map("idempotency_key")
  status          String    @default("pending") // pending | confirmed | expired
  subtotal        Decimal   @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  shippingAmount  Decimal   @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  discountAmount  Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  couponCode      String?   @map("coupon_code")
  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("checkout_sessions")
}

// ---------- Orders (DDD Section 2.11) — immutable once created, ----------
// ---------- except for status transitions (append-only history)  ----------

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number")
  userId          String?     @map("user_id") // nullable: guest order (BR-002)
  addressId       String?     @map("address_id") // optional link back to a saved Address, for registered users only
  shippingAddress Json        @map("shipping_address") // snapshot used for fulfillment — always present, guest or registered
  subtotal        Decimal     @db.Decimal(12, 2)
  taxAmount       Decimal     @map("tax_amount") @db.Decimal(12, 2)
  shippingAmount  Decimal     @map("shipping_amount") @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  status          OrderStatus @default(pending)
  shippedAt       DateTime?   @map("shipped_at")
  deliveredAt     DateTime?   @map("delivered_at")
  deliveryConfirmedBy String? @map("delivery_confirmed_by") // "buyer" | "auto"
  createdAt       DateTime    @default(now()) @map("created_at")

  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  address          Address?           @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  payments         Payment[]
  shipment         Shipment?
  couponRedemption CouponRedemption?
  reviews          Review[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([addressId])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid())
  orderId          String  @map("order_id")
  productVariantId String  @map("product_variant_id")
  quantity         Int
  priceAtPurchase  Decimal @map("price_at_purchase") @db.Decimal(12, 2)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  changedAt DateTime    @default(now()) @map("changed_at")
  changedBy String?     @map("changed_by") // userId of staff, null if system/customer-triggered

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_status_history")
}

// ---------- Payments (DDD Section 2.12) ----------

model Payment {
  id                     String        @id @default(uuid())
  orderId                String        @map("order_id")
  gatewayPaymentIntentId String?       @unique @map("gateway_payment_intent_id")
  amount                 Decimal       @db.Decimal(12, 2)
  method                 PaymentMethod
  status                 PaymentStatus @default(pending)
  idempotencyKey         String        @unique @map("idempotency_key")
  createdAt              DateTime      @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id              String       @id @default(uuid())
  paymentId       String       @map("payment_id")
  gatewayRefundId String?      @unique @map("gateway_refund_id")
  amount          Decimal      @db.Decimal(12, 2)
  status          RefundStatus @default(pending)
  reason          String?
  createdAt       DateTime     @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@map("refunds")
}

// ---------- Shipping (DDD Section 2.13) ----------

model ShippingZone {
  id        String    @id @default(uuid())
  name      String
  countries String[] // e.g. ["PK"]
  deletedAt DateTime? @map("deleted_at")

  rates ShippingRate[]

  @@map("shipping_zones")
}

model ShippingRate {
  id      String  @id @default(uuid())
  zoneId  String  @map("zone_id")
  method  String // "standard" | "express"
  cost    Decimal @db.Decimal(12, 2)
  etaDays Int     @map("eta_days")

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, method])
  @@map("shipping_rates")
}

model Shipment {
  id             String         @id @default(uuid())
  orderId        String         @unique @map("order_id")
  trackingNumber String?        @map("tracking_number")
  courier        String?
  status         ShipmentStatus @default(pending)
  createdAt      DateTime       @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("shipments")
}

// ---------- Reviews (DDD Section 2.14) ----------

model Review {
  id        String    @id @default(uuid())
  orderId   String    @map("order_id")
  productId String    @map("product_id")
  userId    String    @map("user_id")
  rating    Int
  comment   String?
  hidden    Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId, userId])
  @@index([productId])
  @@index([orderId])
  @@index([userId])
  @@map("reviews")
}

// ---------- Notifications (DDD Section 2.15) ----------

enum NotificationChannel {
  email
  sms
}

enum NotificationStatus {
  pending
  sent
  failed
}

model NotificationLog {
  id        String              @id @default(uuid())
  userId    String?             @map("user_id") // nullable: system/guest-triggered
  type      String // e.g. "order_confirmation", "password_reset", "low_stock_alert"
  channel   NotificationChannel
  recipient String // email address or phone number at time of send
  status    NotificationStatus  @default(pending)
  error     String?
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([userId])
  @@index([type, status])
  @@map("notification_logs")
}

model NotificationPreference {
  id                 String  @id @default(uuid())
  userId             String  @unique @map("user_id")
  marketingEmailsOptIn Boolean @default(true) @map("marketing_emails_opt_in")

  @@map("notification_preferences")
}

// ---------- Settings (DDD Section 2.19) ----------

model PlatformSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String // stored as string; parsed by type at the application layer

  @@map("platform_settings")
}

model TaxRule {
  id        String    @id @default(uuid())
  country   String // ISO country code
  region    String? // optional sub-region (state/province); null = country-wide default
  rate      Decimal   @db.Decimal(5, 4) // e.g. 0.0825 for 8.25%
  deletedAt DateTime? @map("deleted_at")

  @@unique([country, region])
  @@map("tax_rules")
}

// ---------- Audit Logs (DDD Section 2.18) — immutable, never updated/deleted ----------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id") // nullable: system-triggered actions
  action     String // e.g. "product.price_updated", "coupon.created", "refund.issued"
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------- Analytics (DDD Section 2.16) ----------

model AbandonedCartSnapshot {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  cartItems Json     @map("cart_items") // snapshot of items at capture time
  subtotal  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("abandoned_cart_snapshots")
}

// ---------- CMS (DDD Section 2.17) ----------

model CmsPage {
  id        String    @id @default(uuid())
  slug      String    @unique
  title     String
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("cms_pages")
}

model Banner {
  id        String    @id @default(uuid())
  imageUrl  String    @map("image_url")
  linkUrl   String?   @map("link_url")
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  sortOrder Int       @default(0) @map("sort_order")
  deletedAt DateTime? @map("deleted_at")

  @@map("banners")
}

model FaqEntry {
  id        String    @id @default(uuid())
  question  String
  answer    String
  sortOrder Int       @default(0) @map("sort_order")
  deletedAt DateTime? @map("deleted_at")

  @@map("faq_entries")
}

